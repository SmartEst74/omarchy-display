<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://github.com/SmartEst74/omarchy-display" version="1.3.0" viewmodes="maximized">
  <tizen:application id="OmarchyTV1.Display" package="OmarchyTV1" required_version="3.0"/>
  <content src="index.html"/>
  <name>Omarchy Display</name>
  <icon src="icon.png"/>
  <access origin="*" subdomains="true"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:content-security-policy>default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; connect-src ws: wss: http: https:; media-src 'none'; object-src 'none'; base-uri 'none'</tizen:content-security-policy>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
